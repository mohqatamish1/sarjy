# Copy to .env. Choose your own database password before starting.
POSTGRES_USER=sarjy
POSTGRES_DB=sarjy
POSTGRES_PASSWORD=
APP_PORT=3000
# Browser origin; update this and COOKIE_SECURE for an HTTPS deployment.
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Riyadh
# Optional until you want real AI chat / transcription. Never sent to the browser.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_TTS_ARABIC_MODEL=canopylabs/orpheus-arabic-saudi
GROQ_TTS_ARABIC_VOICE=fahad
# Open-Meteo public endpoint is for non-commercial evaluation. See README for paid use.
OPEN_METEO_API_KEY=
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
